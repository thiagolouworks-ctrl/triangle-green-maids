---
/*
  Home — v5 Organic Editorial (Figma 44:279). Section order mirrors the frame:
  Top Bar · Header · Hero · Trust · Services · Owner · Testimonials · Service Area · FAQ · Final CTA · Footer.
*/
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import Services from '../components/Services.astro';
import LeafShadow from '../components/LeafShadow.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Owner from '../components/Owner.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <TopBar />
  <Header />
  <main>
    <Hero />
    <div class="relative isolate bg-ivory">
      <LeafShadow />
      <Trust />
      <SectionDivider />
      <Services />
    </div>
    <SectionDivider />
    <Owner />
    <SectionDivider />
    <Testimonials />
    <SectionDivider />
    <ServiceArea />
    <SectionDivider />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
