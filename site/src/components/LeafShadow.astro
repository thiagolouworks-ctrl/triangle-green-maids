---
/*
  LeafShadow (Figma 49:377) — leaf shadows swaying in a breeze.
  A 20s ping-pong loop generated in Magnific (Kling 2.5) from our own leaf-shadow photo,
  cropped and toned to grayscale with a white wall, then multiply-blended so only the
  shadow shows. Faded by the radial mask exported from Figma + a linear fade at the base.

  Props
  - corner: which top corner the light falls from (left mirrors the video).
  - warmth: 0 (morning, neutral) → 1 (late afternoon, amber). Used down the page so the
    light seems to move through the day as you scroll.
  - offset: start the loop at a different second so repeated sections don't sway in sync.
  The parent needs `relative isolate` + a background (multiply needs a backdrop).
  Reduced motion → paused on the poster frame (motion.ts).
*/
interface Props {
  corner?: 'right' | 'left';
  warmth?: number;
  offset?: number;
  height?: number;
  /** Fade in from the top edge (for sections whose top border is visible). */
  fadeTop?: boolean;
}

import leafMask from '../assets/icons/leaf-mask.svg?url';

const { corner = 'right', warmth = 0, offset = 0, height = 800, fadeTop = false } = Astro.props;

const pos = corner === 'right' ? 'calc(100% + 420px) -420px' : '-420px -420px';
const mask = `mask-image:url(${leafMask});-webkit-mask-image:url(${leafMask});mask-size:1700px 1200px;-webkit-mask-size:1700px 1200px;mask-position:${pos};-webkit-mask-position:${pos};mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;`;
// Warm the shadow towards amber: sepia + a touch of saturation; slightly softer as the day goes on.
// brightness() pushes the near-white wall to pure white so only the shadow is tinted.
const filter = warmth > 0 ? `filter:sepia(${(0.35 * warmth).toFixed(2)}) brightness(${(1 + 0.06 * warmth).toFixed(3)});` : '';
const fade = fadeTop
  ? 'linear-gradient(to bottom, transparent 0%, black 22%, black 50%, transparent 100%)'
  : 'linear-gradient(to bottom, black 45%, transparent 100%)';
const opacity = (0.85 - 0.25 * warmth).toFixed(2);
---

<div
  class="pointer-events-none absolute inset-x-0 top-0 z-0 overflow-hidden mix-blend-multiply"
  style={`height:${height}px;opacity:${opacity};mask-image:${fade};-webkit-mask-image:${fade};`}
  aria-hidden="true"
>
  <div class="absolute inset-0" style={mask}>
    <video
      class:list={[
        'leaf-shadow__video absolute inset-0 size-full object-cover',
        // The source frame has its leaves top-right; mirror it for the left corner.
        'object-right-top',
        corner === 'left' && '-scale-x-100',
      ]}
      style={filter}
      poster="/media/leaf-shadow-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="metadata"
      tabindex="-1"
      data-ambient-video
      data-offset={offset}
    >
      <source src="/media/leaf-shadow.webm" type="video/webm" />
      <source src="/media/leaf-shadow.mp4" type="video/mp4" />
    </video>
  </div>
</div>
