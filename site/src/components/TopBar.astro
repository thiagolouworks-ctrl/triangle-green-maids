---
/* 00 Top Bar (44:280). Hidden below md, as on the published site; the message also lives in the hero. */
import { topBar, contact } from '../data/content';
import { displayCase } from '../lib/text';
---

<div data-top-bar class="on-dark hidden h-12 bg-forest text-white md:block">
  <div class="container-page type-label-eyebrow flex h-full items-center justify-between gap-lg">
    <p class="truncate">{topBar.message}</p>
    <div class="flex shrink-0 items-center gap-lg">
      <a href={contact.email.href} class="transition-opacity duration-500 hover:opacity-70"><span data-display-case>{displayCase(contact.email.label)}</span></a>
      <a href={contact.phone.href} class="transition-opacity duration-500 hover:opacity-70">{contact.phone.label}</a>
    </div>
  </div>
</div>
